{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gamut",
  "version": "0.7.0",
  "identifier": "com.rymera.gamut",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gamut",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' data: https: http://localhost:*; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:*; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "linux/Gamut.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/Gamut.desktop"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Rymera-Web-Co/Gamut/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlCRTVCQjQwNEUyRDNCQTYKUldTbU95MU9RTHZsbTFabmtzejF3TnMzMndOYmRIUkh2ZjVOcG5iUzNveDgyQWZFMzhQZEV3MHYK"
    }
  }
}
